{
  "name": "@autoapply/api",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --transpile-only --respawn --exit-child src/index.ts",
    "worker:dev": "ts-node-dev --transpile-only --respawn --exit-child src/workers/index.ts",
    "start": "node dist/index.js",
    "worker": "node dist/workers/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "jest --runInBand",
    "prisma:generate": "prisma generate --schema src/db/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema src/db/prisma/schema.prisma"
  },
  "dependencies": {
    "@autoapply/shared": "0.1.0",
    "@prisma/client": "^5.22.0",
    "axios": "^1.12.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^4.18.0",
    "cheerio": "^1.1.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^7.2.0",
    "ioredis": "^5.6.1",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.10.0",
    "openai": "^4.93.0",
    "pdf-parse": "^1.1.1",
    "pino-http": "^10.5.0",
    "prisma": "^5.22.0",
    "resend": "^4.6.0",
    "winston": "^3.17.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.44.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.23",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.17.30",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.17",
    "@types/pdf-parse": "^1.1.5",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.26.0",
    "@typescript-eslint/parser": "^8.26.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^10.1.1",
    "jest": "^29.7.0",
    "playwright": "1.44.0",
    "prettier": "^3.5.3",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.6",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.8.2"
  }
}
