# App
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://autoapply:secret@localhost:5432/autoapply
POSTGRES_USER=autoapply
POSTGRES_PASSWORD=secret
POSTGRES_DB=autoapply

# Redis
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=your-jwt-secret-min-32-chars
JWT_EXPIRES_IN=7d

# Encryption (must be exactly 32 characters)
ENCRYPTION_KEY=your-32-char-encryption-key-here!

# LinkedIn OAuth
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3001/api/auth/linkedin/callback

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Email (Resend — preferred)
RESEND_API_KEY=
FROM_EMAIL=AutoApply <noreply@autoapply.dev>

# Email fallback (Nodemailer SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Agent
AGENT_DEFAULT_SCHEDULE=0 */2 * * *
MAX_APPLICATIONS_PER_RUN=20

# File Storage
UPLOADS_DIR=./uploads
MAX_FILE_SIZE_MB=10

# Frontend (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret

